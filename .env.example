APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
WORKSPACE_ROOT=./workspaces
SKILL_ROOT=./DAskill/data-analysis
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8192
# Set to false for reasoning models that otherwise consume the output budget before JSON.
# LLM_THINKING_ENABLED=false

MAX_AGENT_STEPS=30
MAX_EXECUTIONS_PER_RUN=20
MAX_CODE_RETRY=3
# Local non-convergence limit; successful deeper validation does not consume it.
MAX_REPORT_PREPARATION_ATTEMPTS=3
PYTHON_TIMEOUT_SECONDS=120
PYTHON_MEMORY_LIMIT=2g
PYTHON_CPU_LIMIT=2
SANDBOX_IMAGE=ai-analysis-sandbox:latest
