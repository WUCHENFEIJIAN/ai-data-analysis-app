ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg

ARG INSTALL_FROM_WHEELHOUSE=0
ARG PIP_INDEX_URL
COPY wheels /wheels
RUN if [ "$INSTALL_FROM_WHEELHOUSE" = "1" ]; then PIP_ARGS="--no-index --find-links=/wheels"; else PIP_ARGS=""; fi \
    && pip install --no-cache-dir $PIP_ARGS \
    pandas==2.3.3 \
    numpy==2.3.5 \
    openpyxl==3.1.5 \
    xlrd==2.0.2 \
    matplotlib==3.10.8 \
    seaborn==0.13.2 \
    scipy==1.16.3 \
    plotly==6.5.0 \
    scikit-learn==1.8.0 \
    && rm -rf /wheels \
    && useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin analyst

USER 65532:65532
WORKDIR /workspace
